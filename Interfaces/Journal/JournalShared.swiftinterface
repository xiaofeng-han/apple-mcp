// swift-interface-format-version: 1.0
// swift-module-flags: -target arm64-apple-macos26.0 -enable-library-evolution -swift-version 5 -module-name JournalShared
//
// The part of JournalShared, Journal's private framework, that Apple Journal MCP calls: Journal's own
// data model and the code that keeps it consistent and ready for Journal to sync. Written by hand from
// the framework's exported symbols on macOS 27.2 (Journal 3.0; see docs/RE-FINDINGS-journal.md). Every
// declaration must mangle exactly as the framework's own: the types are resilient, so their layout
// is never assumed, but a wrong name, label or kind (struct, enum, class) calls nothing or the wrong
// thing. Methods of the managed object classes are in extensions because the framework declares
// them there (called directly, not through a dispatch thunk).
import Coherence
import CoreData
import CoreGraphics
import Foundation
import Swift

extension CoreData.NSManagedObjectModel {
  /// Journal's model; reading it also registers the value transformers its mergeable attributes need.
  public static var shared: CoreData.NSManagedObjectModel { get }
}

